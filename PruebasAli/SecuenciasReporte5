/////////////////////////////////////////////////////////////////////////////////////////////////////////
             Agregar juguetes al catalogo de una tienda y asignarle un lote
//////////////////////////////////////////////////////////////////////////////////////////////////////////


SET SERVEROUTPUT ON;
SET VERIFY OFF;

PROMPT =================================================;
PROMPT        LISTA DE JUGUETES (MAESTRO)
PROMPT =================================================;

SELECT codigo, nombre, tipo_lego 
FROM JUGUETES 
WHERE ROWNUM <= 15 -- Muestro solo 15 para no saturar
ORDER BY nombre;

PROMPT ;
PROMPT =================================================;
PROMPT        TIENDAS DISPONIBLES POR PAIS
PROMPT =================================================;

SELECT 
    p.id AS ID_PAIS,
    p.nombre AS PAIS,
    t.id AS ID_TIENDA,
    t.nombre AS NOMBRE_TIENDA
FROM PAISES p
JOIN TIENDAS_LEGO t ON p.id = t.id_pais
ORDER BY p.nombre, t.nombre;

