/////////////////////////////////////////////////////////////////////////////////////////////////////////
                COMPRA DE JUGUETE
/////////////////////////////////////////////////////////////////////////////////////////////////////////


-- Ejecuta esto primero para ver el MENÚ DE PAÍSES DISPONIBLES
SELECT 
    p.id AS ID_PAIS, 
    p.nombre AS PAIS, 
    p.continente,
    (SELECT COUNT(*) FROM TIENDAS_LEGO t WHERE t.id_pais = p.id) AS NRO_TIENDAS
FROM PAISES p
WHERE EXISTS (SELECT 1 FROM TIENDAS_LEGO t WHERE t.id_pais = p.id)
ORDER BY p.nombre;


-- AHORA EJECUTA ESTE BLOQUE COMPLETO PARA INICIAR LA COMPRA
SET SERVEROUTPUT ON;
SET VERIFY OFF;

-- 1. VENTANA EMERGENTE: Te pedirá el Año y el País
DEFINE anio_elegido = &Escribe_el_Anio_Venta;
DEFINE pais_elegido = &Escribe_ID_Pais_Compra;

PROMPT ==================================================;
PROMPT        TIENDAS DISPONIBLES EN PAIS ID &pais_elegido;
PROMPT ==================================================;

-- Esto imprimirá las tiendas del país seleccionado
DECLARE
    CURSOR c_tiendas IS
        SELECT id, nombre, direccion 
        FROM TIENDAS_LEGO 
        WHERE id_pais = &pais_elegido;
BEGIN
    FOR t IN c_tiendas LOOP
        DBMS_OUTPUT.PUT_LINE('ID TIENDA: ' || t.id || ' | ' || t.nombre || ' (' || t.direccion || ')');
    END LOOP;
END;
/

PROMPT ;
PROMPT Elija una tienda de la lista de arriba...;
PROMPT ;

-- 2. VENTANA EMERGENTE: Te pedirá la Tienda
DEFINE tienda_elegida = &Escribe_ID_Tienda_Compra;

PROMPT ==================================================;
PROMPT    STOCK EN LA TIENDA SELECCIONADA (ID &tienda_elegida);
PROMPT ==================================================;

-- Esto imprimirá los juguetes QUE TIENEN STOCK en esa tienda específica
DECLARE
    CURSOR c_juguetes IS
        SELECT j.codigo, j.nombre, l.cant_prod
        FROM LOTES_SET_TIENDA l
        JOIN JUGUETES j ON l.cod_juguete = j.codigo
        WHERE l.id_tienda = &tienda_elegida
        AND l.cant_prod > 0
        AND ROWNUM <= 15;
    v_found BOOLEAN := FALSE;
BEGIN
    FOR r IN c_juguetes LOOP
        DBMS_OUTPUT.PUT_LINE('ID JUGUETE: ' || r.codigo || ' | ' || r.nombre || ' | Stock: ' || r.cant_prod);
        v_found := TRUE;
    END LOOP;
    
    IF NOT v_found THEN
        DBMS_OUTPUT.PUT_LINE('No hay stock disponible en esta tienda actualmente.');
    END IF;
END;
/

PROMPT ;
PROMPT Mira el stock de arriba y elige tu juguete...;
PROMPT ;

-- 3. VENTANA EMERGENTE: Te pedirá Juguete y Cantidad
DEFINE juguete_elegido = &Escribe_ID_Juguete;
DEFINE cantidad_compra = &Escribe_Cantidad;

-- 4. PROCESAR LA COMPRA FINAL
BEGIN
    SP_PROCESAR_COMPRA(
        p_anio        => &anio_elegido,
        p_id_pais     => &pais_elegido,
        p_id_tienda   => &tienda_elegida,  -- Ahora enviamos la tienda
        p_cod_juguete => &juguete_elegido,
        p_cantidad    => &cantidad_compra
    );
EXCEPTION
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('ERROR EN LA COMPRA: ' || SQLERRM);
END;
/












/////////////////////////////////////////////////////////////////////////////////////////////////////////
             Agregar juguetes al catalogo de una tienda y asignarle un lote
//////////////////////////////////////////////////////////////////////////////////////////////////////////

-- ======================================================================
-- PASO 1: VER LISTA DE PAISES (Sombrea y presiona F5)
-- ======================================================================
SET SERVEROUTPUT ON;
PROMPT ;
PROMPT [ LISTA DE PAISES DISPONIBLES ];
PROMPT ;

SELECT id AS ID_PAIS, nombre AS NOMBRE, continente 
FROM PAISES 
WHERE EXISTS (SELECT 1 FROM TIENDAS_LEGO t WHERE t.id_pais = PAISES.id)
ORDER BY nombre;


-- ======================================================================
-- PASO 2: ELEGIR PAIS Y VER TIENDAS (Sombrea y presiona F5)
-- ======================================================================
-- Nota: Te pedirá el ID del país que viste arriba
DEFINE v_pais_elegido = &Escribe_ID_Pais_del_Paso_1;

PROMPT ;
PROMPT [ TIENDAS EN EL PAIS &v_pais_elegido ];
PROMPT ;

SELECT id AS ID_TIENDA, nombre AS NOMBRE_TIENDA, direccion
FROM TIENDAS_LEGO
WHERE id_pais = &v_pais_elegido
ORDER BY nombre;


-- ======================================================================
-- PASO 3: VER CATALOGO DE JUGUETES (Sombrea y presiona F5)
-- ======================================================================
PROMPT ;
PROMPT [ JUGUETES DISPONIBLES (Maestro) ];
PROMPT ;

SELECT codigo AS ID_JUGUETE, nombre, tipo_lego
FROM JUGUETES
WHERE ROWNUM <= 25
ORDER BY nombre;


-- ======================================================================
-- PASO 4: EJECUTAR EL ABASTECIMIENTO (Sombrea y presiona F5)
-- ======================================================================
SET SERVEROUTPUT ON;
SET VERIFY OFF;

-- Te pedirá confirmar los datos que elegiste en los pasos anteriores
DEFINE in_pais     = &Confirma_ID_Pais;
DEFINE in_tienda   = &Escribe_ID_Tienda_Elegida;
DEFINE in_juguete  = &Escribe_ID_Juguete_Elegido;
DEFINE in_cantidad = &Escribe_Cantidad_Lote;

BEGIN
    SP_AGREGAR_STOCK(
        p_id_pais     => &in_pais,
        p_id_tienda   => &in_tienda,
        p_cod_juguete => &in_juguete,
        p_cantidad    => &in_cantidad
    );
END;
/










///
Cambiar precio historico
////




SET SERVEROUTPUT ON;
PROMPT ;
PROMPT [ PRECIOS VIGENTES ACTUALMENTE ];
PROMPT ;

SELECT 
    j.codigo AS ID, 
    j.nombre AS JUGUETE, 
    h.precio AS PRECIO_ACTUAL,
    h.f_inicio AS VIGENTE_DESDE
FROM JUGUETES j
JOIN HISTORICO_PRECIOS_JUGUETES h ON j.codigo = h.cod_juguete
WHERE h.f_fin IS NULL -- Solo mostramos el precio activo
ORDER BY j.nombre;






SET SERVEROUTPUT ON;
SET VERIFY OFF;

-- Preguntas
DEFINE juguete_id  = &Escribe_ID_Juguete;
DEFINE nuevo_monto = &Nuevo_Precio;
DEFINE fecha_cambio = &Fecha_Inicio_DD_MM_AAAA; -- Escribe ej: 01/01/2026

BEGIN
    SP_ACTUALIZAR_PRECIO(
        p_cod_juguete  => &juguete_id,
        p_nuevo_precio => &nuevo_monto,
        -- El cambio está aquí: SUBSTR corta el texto a 10 letras para evitar el error
        p_fecha_inicio => TO_DATE(SUBSTR('&fecha_cambio', 1, 10), 'DD/MM/YYYY')
    );
END;
/
